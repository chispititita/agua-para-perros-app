# Copia este archivo a .env y rellena tus claves. Nunca subas .env al repo.
ANTHROPIC_API_KEY=

# Opcional, solo si tienes una para evitar límites de tasa bajos en PageSpeed Insights.
PAGESPEED_API_KEY=

# Necesarias para el botón "Conectar con Shopify" (OAuth, un clic).
# Se obtienen creando una app una sola vez en tu Shopify Partners
# Dashboard — ver el README, sección "Conectar con Shopify".
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
