# ==========================================================
#  CONFIGURACIÓN DE JARVIS
#  Jarvis funciona GRATIS y SIN CLAVES tal cual.
#  La clave de Claude de abajo es OPCIONAL: solo sirve
#  para que Jarvis sea más listo (IA de pago).
# ==========================================================

# --- Tus datos ---
USUARIO_NOMBRE=Carlos

# --- Cerebro de Jarvis ---
# Sin clave: usa una IA gratuita que corre en tu ordenador (Ollama).
# Modelo local: qwen2.5:7b (necesita ~8 GB de RAM). Si tu PC va justo, prueba qwen2.5:3b.
MODELO_LOCAL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# OPCIONAL: con una clave de Claude (https://platform.claude.com/) Jarvis es mucho más listo (de pago por uso).
ANTHROPIC_API_KEY=

# --- Voz ---
# Palabra para despertar a Jarvis en modo manos libres
PALABRA_ACTIVACION=jarvis

# --- Avanzado ---
PUERTO=5757
MODELO_CLAUDE=claude-opus-5-5
# low = respuestas más rápidas (ideal para voz) · medium / high = piensa más
ESFUERZO_CLAUDE=low
