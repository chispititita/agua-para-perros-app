# ==========================================================
#  CONFIGURACIÓN DE JARVIS
#  Jarvis funciona GRATIS y SIN CLAVES tal cual.
#  Las claves de abajo son OPCIONALES: solo sirven para
#  mejorar la calidad (IA de pago).
# ==========================================================

# --- Tus datos ---
USUARIO_NOMBRE=Carlos
TIENDA_NOMBRE=Agua Para Perros
TIENDA_DESCRIPCION=Tienda online de bebederos y botellas de agua portátiles para perros, para paseos, viajes y excursiones.

# --- Cerebro de Jarvis ---
# Sin clave: usa una IA gratuita que corre en tu ordenador (Ollama).
# Modelo local: qwen2.5:7b (necesita ~8 GB de RAM). Si tu PC va justo, prueba qwen2.5:3b.
MODELO_LOCAL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# OPCIONAL: con una clave de Claude (https://platform.claude.com/) Jarvis es mucho más listo (de pago por uso).
ANTHROPIC_API_KEY=

# --- Imágenes y vídeos ---
# Sin token: imágenes gratis (Pollinations) y vídeos montados en tu ordenador (zoom + texto).
DURACION_VIDEO=6
# OPCIONAL: con un token de Replicate (https://replicate.com/account/api-tokens) los vídeos los crea
# una IA de vídeo de verdad (de pago por uso).
REPLICATE_API_TOKEN=
# Modelos de Replicate (solo si pones el token)
MODELO_IMAGEN=black-forest-labs/flux-schnell
MODELO_VIDEO=minimax/video-01
# Nombre del campo donde el modelo de vídeo recibe la imagen de partida
MODELO_VIDEO_CLAVE_IMAGEN=first_frame_image

# --- Tienda Shopify (opcional, solo lectura) ---
# Ejemplo: agua-para-perros.myshopify.com
SHOPIFY_TIENDA=
# Token de una app personalizada con permisos read_products y read_orders
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2025-07

# --- Voz ---
# Palabra para despertar a Jarvis en modo manos libres
PALABRA_ACTIVACION=jarvis

# --- Avanzado ---
PUERTO=5757
MODELO_CLAUDE=claude-opus-5-5
# low = respuestas más rápidas (ideal para voz) · medium / high = piensa más
ESFUERZO_CLAUDE=low
