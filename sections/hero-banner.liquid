{% comment %}
  Hero banner — Agua Para Perros
  Sección de portada con imagen de fondo (desktop/mobile), título, subtítulo y hasta 2 botones.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .hero-banner {
    position: relative;
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    justify-content: {{ section.settings.horizontal_align }};
    min-height: {{ section.settings.height_mobile }}px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero-banner {
      min-height: {{ section.settings.height_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} .hero-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #e8e6e1;
  }

  #shopify-section-{{ section.id }} .hero-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-banner__media--mobile {
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-banner__media--desktop {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero-banner__media--mobile {
      display: none;
    }
    #shopify-section-{{ section.id }} .hero-banner__media--desktop {
      display: block;
    }
  }

  #shopify-section-{{ section.id }} .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #shopify-section-{{ section.id }} .hero-banner__content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    padding: 3rem 1.5rem;
    color: {{ section.settings.text_color }};
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: {{ section.settings.text_align }};
    align-items: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .hero-banner__heading {
    font-size: clamp(1.75rem, 4vw + 1rem, 3.25rem);
    line-height: 1.1;
    margin: 0;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hero-banner__subheading {
    font-size: clamp(1rem, 1.2vw + 0.75rem, 1.25rem);
    margin: 0;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .hero-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  #shopify-section-{{ section.id }} .hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  #shopify-section-{{ section.id }} .hero-banner__button:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  #shopify-section-{{ section.id }} .hero-banner__button--primary {
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .hero-banner__button--secondary {
    background: transparent;
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.text_color }};
  }
{% endstyle %}

<div class="hero-banner">
  <div class="hero-banner__media">
    {% if section.settings.image_mobile != blank %}
      <img
        class="hero-banner__media--mobile"
        src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
        srcset="{{ section.settings.image_mobile | image_url: width: 500 }} 500w, {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w"
        sizes="100vw"
        alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image_mobile.width }}"
        height="{{ section.settings.image_mobile.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {% elsif section.settings.image_desktop != blank %}
      <img
        class="hero-banner__media--mobile"
        src="{{ section.settings.image_desktop | image_url: width: 1000 }}"
        alt="{{ section.settings.image_desktop.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}

    {% if section.settings.image_desktop != blank %}
      <img
        class="hero-banner__media--desktop"
        src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
        srcset="{{ section.settings.image_desktop | image_url: width: 1200 }} 1200w, {{ section.settings.image_desktop | image_url: width: 1800 }} 1800w, {{ section.settings.image_desktop | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image_desktop.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  {% if section.settings.overlay_opacity > 0 %}
    <div class="hero-banner__overlay"></div>
  {% endif %}

  <div class="hero-banner__content">
    {% if section.settings.heading != blank %}
      <h2 class="hero-banner__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}
      <div class="hero-banner__buttons">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="hero-banner__button hero-banner__button--primary">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        {% if section.settings.button_label_2 != blank %}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="hero-banner__button hero-banner__button--secondary">
            {{ section.settings.button_label_2 }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image_desktop", "label": "Imagen de fondo (escritorio)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen de fondo (móvil)", "info": "Si se deja vacío, se usa la imagen de escritorio recortada." },
    { "type": "range", "id": "height_desktop", "label": "Altura en escritorio", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "height_mobile", "label": "Altura en móvil", "min": 300, "max": 700, "step": 10, "unit": "px", "default": 420 },
    { "type": "color", "id": "overlay_color", "label": "Color de superposición", "default": "#0b0b0b" },
    { "type": "range", "id": "overlay_opacity", "label": "Opacidad de superposición", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },

    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Agua fresca para tu perro, vayas donde vayas" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Bebederos portátiles antifugas, listos para paseos, viajes y aventuras." },
    { "type": "select", "id": "text_align", "label": "Alineación del texto", "default": "left", "options": [
      { "value": "left", "label": "Izquierda" },
      { "value": "center", "label": "Centro" },
      { "value": "right", "label": "Derecha" }
    ]},
    { "type": "select", "id": "vertical_align", "label": "Alineación vertical", "default": "center", "options": [
      { "value": "flex-start", "label": "Arriba" },
      { "value": "center", "label": "Centro" },
      { "value": "flex-end", "label": "Abajo" }
    ]},
    { "type": "select", "id": "horizontal_align", "label": "Alineación horizontal", "default": "flex-start", "options": [
      { "value": "flex-start", "label": "Izquierda" },
      { "value": "center", "label": "Centro" },
      { "value": "flex-end", "label": "Derecha" }
    ]},
    { "type": "color", "id": "text_color", "label": "Color de texto", "default": "#ffffff" },

    { "type": "header", "content": "Botón principal" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "color", "id": "button_bg", "label": "Fondo del botón", "default": "#378add" },
    { "type": "color", "id": "button_text_color", "label": "Texto del botón", "default": "#ffffff" },

    { "type": "header", "content": "Botón secundario" },
    { "type": "text", "id": "button_label_2", "label": "Texto del botón secundario" },
    { "type": "url", "id": "button_link_2", "label": "Enlace del botón secundario" }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
